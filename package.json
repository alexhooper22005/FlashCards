{
  "name": "studyflash",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "test": "jest --runInBand",
    "test:unit": "node --experimental-strip-types --test tests/unit/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "expo": "~58.0.12",
    "expo-status-bar": "~58.0.3",
    "react": "19.3.0",
    "react-native": "0.88.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "29.5.14",
    "@types/node": "^24.10.0",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.16",
    "jest": "~29.7.0",
    "jest-expo": "~58.0.11",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "<rootDir>/src/**/*.test.ts?(x)"
    ]
  }
}
